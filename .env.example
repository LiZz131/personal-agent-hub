# 复制为 .env 后填写：  copy .env.example .env
# .env 已在 .gitignore 中，且对 Claude Code 禁读（只有脚本会读取它）

# ---- 必填：飞书开放平台 → 你的应用 → 凭证与基础信息 ----
# 形如 cli_a1b2c3d4e5f6g7h8
FEISHU_APP_ID=
# 32 位左右的字符串；泄露后在同一页面点「重置」
FEISHU_APP_SECRET=

# ---- 必填：你本人的 open_id（docs/feishu-setup.md 第 7 步打印出来） ----
# 形如 ou_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx。只响应这个 open_id 发来的消息
FEISHU_OWNER_OPEN_ID=

# ---- 可选 ----
# feishu（国内飞书，默认）或 lark（海外版 Lark）
FEISHU_DOMAIN=feishu
# 简报/提醒默认发到与你的单聊；如要发到某个群，填群的 chat_id（oc_ 开头），多个用逗号分隔
FEISHU_DIGEST_CHAT_IDS=

# ============================================================
# 项目通知（docs/feishu-project-notify.md）
# 所有 Claude Code 事件（需要审批 / 等你回复 / 长任务完成）先汇入 hub，
# 再由 Personal Agent 机器人发到群里，因此 agent 自己也知道这些事件。
# ============================================================

# 默认的「项目通知」群 chat_id（oc_ 开头）。文档第 3 步获取。
# 留空则发到与你的单聊。
FEISHU_NOTIFY_CHAT_ID=

# 可选：按项目分群。格式「项目名=chat_id」，多个用逗号分隔；项目名与 projects/*.md 的文件名一致。
# 没有列出的项目发到 FEISHU_NOTIFY_CHAT_ID。例如：
# FEISHU_PROJECT_CHAT_IDS=project-a=oc_aaa,project-b=oc_bbb
FEISHU_PROJECT_CHAT_IDS=

# 可选兜底：群里的「自定义机器人」webhook（文档第 4 步）。
# 只在 hub 不可用时，用于远程「需要审批」类事件的直接告警；正常情况下不用它。
# 注意：webhook 机器人发出的消息，Personal Agent 看不到。
FEISHU_NOTIFY_WEBHOOK_URL=
# 自定义机器人的「签名校验」密钥
FEISHU_NOTIFY_WEBHOOK_SECRET=

# ---- 通知节奏（可选，括号里是默认值） ----
# Stop（一轮结束）只在距离你上次发消息超过 N 分钟时才通知（3），避免你在电脑前时刷屏
NOTIFY_LONG_TASK_MINUTES=3
# 同一会话、同一类通知的最短间隔，单位秒（120）
NOTIFY_DEDUP_SECONDS=120
