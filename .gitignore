.venv/
tools/cc-connect/*.exe
tools/cc-connect/*.zip
tools/cc-connect/data/
tools/cc-connect/.config.toml.lock
feeds/state.json
feeds/candidates/
.cache/
.secrets/
vendor/
tools/cc-connect/*.exe.*
events/
state/
